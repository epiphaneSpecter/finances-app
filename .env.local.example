# Copie ce fichier en `.env.local` et remplis les valeurs depuis ton projet Supabase
# (Dashboard Supabase → Project Settings → API).
#
# IMPORTANT : ne mets JAMAIS la clé "service_role" ici — elle ne doit jamais
# être exposée côté client. Seule la clé "anon" (publique) est autorisée dans le
# frontend. Voir CLAUDE.md section 7 (Sécurité).

# URL de ton projet Supabase (ex: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique "anon" (safe côté client, protégée par la Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publique du site (utile pour les redirections d'auth / liens magiques).
# En local : http://localhost:3000 — en prod : ton domaine Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
